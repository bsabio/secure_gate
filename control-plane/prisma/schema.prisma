// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Evaluation {
  id          String   @id @default(uuid())
  ts          DateTime @default(now())
  scenario    String
  ip          String
  location    String
  userAgent   String
  riskScore   Float
  action      String
  durationMs  Int
  reasoning   String
}
