{
  "name": "secure-gate",
  "version": "0.1.0",
  "description": "AI-driven security middleware for enterprise authentication",
  "main": "dist/index.js",
  "workspaces": [
    "control-plane"
  ],
  "scripts": {
    "dev": "npm --prefix control-plane run dev",
    "build": "npm --prefix control-plane run build",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "lint:control-plane": "npm --prefix control-plane run lint",
    "typecheck": "tsc --noEmit",
    "typecheck:control-plane": "npm --prefix control-plane run typecheck",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --omit=dev --workspaces --include-workspace-root"
  },
  "keywords": [
    "security",
    "authentication",
    "middleware",
    "ai",
    "enterprise"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.4.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "eslint": "^9.4.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.1.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "ai": "^6.0.168",
    "zod": "^4.3.6"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
